         bonus bInt,.@r/3*1;
         bonus bDex,.@r/3*1;
         bonus bLuk,.@r/3*1;
         bonus bVariableCastrate,-(.@r/3*1);
         bonus bDelayrate,-(.@r/3*2);
      }
      if (.@g >= ENCHANTGRADE_C) {
         bonus bAtkRate,5;
