      bonus2 bSkillAtk,"TK_DOWNKICK",100;
      bonus2 bSkillAtk,"TK_TURNKICK",100;
      bonus2 bSkillAtk,"TK_COUNTER",100;
      bonus2 bSkillAtk,"TK_JUMPKICK",100;
      }

      if (.@r>=9) {
         bonus bShortAtkRate,30;
         bonus2 bSubClass,Class_Boss,30;
      }
      if (.@r>=11) {
         bonus bAspdRate,10;
         bonus2 bSubRace,RC_Player_Human,5;
         bonus2 bSubRace,RC_Player_Doram,5;
      }
      if (.@g >= ENCHANTGRADE_D) {
         bonus bAtkRate,5;
         bonus bBaseAtk,20;
      bonus2 bSkillAtk,"TK_STORMKICK",50;
      bonus2 bSkillAtk,"TK_DOWNKICK",50;
      bonus2 bSkillAtk,"TK_TURNKICK",50;
      bonus2 bSkillAtk,"TK_COUNTER",50;
      bonus2 bSkillAtk,"TK_JUMPKICK",50;
         bonus bStr,.@r/3*1;
         bonus bAtkRate,.@r/3*3;
      }
      if (.@g >= ENCHANTGRADE_C) {
         bonus bAtkRate,5;
         bonus bBaseAtk,20;
      bonus2 bSkillAtk,"TK_STORMKICK",50;
      bonus2 bSkillAtk,"TK_DOWNKICK",50;
      bonus2 bSkillAtk,"TK_TURNKICK",50;
      bonus2 bSkillAtk,"TK_COUNTER",50;
      bonus2 bSkillAtk,"TK_JUMPKICK",50;
         bonus bStr,.@r/3*1;
         bonus bAtkRate,.@r/3*3;
      }
      if (.@g >= ENCHANTGRADE_B) {
         bonus bAtkRate,5;
         bonus bBaseAtk,20;
      bonus2 bSkillAtk,"TK_STORMKICK",50;
      bonus2 bSkillAtk,"TK_DOWNKICK",50;
      bonus2 bSkillAtk,"TK_TURNKICK",50;
      bonus2 bSkillAtk,"TK_COUNTER",50;
      bonus2 bSkillAtk,"TK_JUMPKICK",50;
         bonus bStr,.@r/2*1;
         bonus bAtkRate,.@r/2*3;
      }
