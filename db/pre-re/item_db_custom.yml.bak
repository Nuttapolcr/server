      bonus2 bSkillAtk,"TK_TURNKICK",.@r/3*15;
      bonus2 bSkillAtk,"TK_COUNTER",.@r/3*15;
      bonus2 bSkillAtk,"TK_JUMPKICK",.@r/3*15;

      if (.@r>=7) {
         bonus bAtk,100;
         bonus bAtkRate,7;
         bonus bShortAtkRate,10;
